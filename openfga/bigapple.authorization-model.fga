# 大苹果正式命名、通用选民规则与财务职责授权模型 v2026-08-04
model
  schema 1.1

type member

type platform
  relations
    define covenanter: [member]
    define deliberator: [member]
    define maintainer: [member]
    define frozen_member: [member]

type professional_domain
  relations
    define qualified_member: [member]

type proposal
  relations
    define platform: [platform]
    define eligible_member: [member]
    define can_vote: eligible_member but not frozen_member from platform

type role
  relations
    define assignee: [member]

type permission
  relations
    define role: [role]
    define holder: assignee from role

type guarded_permission
  relations
    define role: [role]
    define platform: [platform]
    define holder: (assignee from role and covenanter from platform) but not frozen_member from platform

type resource_permission
  relations
    define role: [role]
    define holder: assignee from role

type guarded_resource_permission
  relations
    define role: [role]
    define platform: [platform]
    define holder: (assignee from role and covenanter from platform) but not frozen_member from platform
