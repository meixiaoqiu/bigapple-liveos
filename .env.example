# Big Apple Live OS Docker development environment example.
# Copy this file to .env and replace CHANGE_ME before running start.bat.

DATABASE_URL=mysql://big_apple_user:CHANGE_ME@mysql97:3306/big_apple_live?charset=utf8mb4
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,bigadmin.local,bigreal.local,bigsim.local
BIG_APPLE_CONTRACTS_ROOT=../bigapple-docs/static/technical-contracts

# Multi-database world routing. DATABASE_URL provides credentials and host;
# the DB_NAME variables swap only the database name.
BIG_APPLE_CONTROL_DB_NAME=dev_big_control
BIG_APPLE_REALWORLD_DB_NAME=dev_big_real
BIG_APPLE_SIMULATION0001_DB_NAME=dev_big_sim0001
BIG_APPLE_WORLD_DATABASE_ALIASES=realworld,simulation0001
BIG_APPLE_DEFAULT_WORLD_DATABASE_ALIAS=realworld

# Authorization engine for world runtime business permissions.
# `openfga` is authoritative for bigreal.local / bigsim.local.
# `legacy` is reserved for Django Admin, tests, and diagnostic commands.
# start.bat validates these values but never modifies .env.
# Use the documented openfga_bootstrap commands and copy their output here.
BIG_APPLE_AUTHORIZATION_BACKEND=openfga
OPENFGA_REAL_API_URL=http://openfga-real:8080
OPENFGA_REAL_STORE_NAME=big-apple-realworld
OPENFGA_REAL_STORE_ID=
OPENFGA_REAL_AUTHORIZATION_MODEL_ID=
OPENFGA_REAL_PLATFORM_OBJECT=platform:realworld
OPENFGA_SIM_API_URL=http://openfga-sim:8082
OPENFGA_SIM_STORE_NAME=big-apple-simulation0001
OPENFGA_SIM_STORE_ID=
OPENFGA_SIM_AUTHORIZATION_MODEL_ID=
OPENFGA_AUTHORIZATION_MODEL_SHA256=
OPENFGA_SIM_PLATFORM_OBJECT=platform:simulation0001

# Optional first maintainer for simulation worlds.
# seed_world creates or updates this account in the target simulation DB.
# Enabled values: 1, true, yes, on. Keep false for public defaults.
BIG_APPLE_SIMULATION_BOOTSTRAP_MAINTAINER_ENABLED=false
BIG_APPLE_SIMULATION_BOOTSTRAP_MAINTAINER_USERNAME=simulation-maintainer
BIG_APPLE_SIMULATION_BOOTSTRAP_MAINTAINER_PASSWORD=CHANGE_ME
BIG_APPLE_SIMULATION_BOOTSTRAP_MAINTAINER_EMAIL=
BIG_APPLE_SIMULATION_BOOTSTRAP_MAINTAINER_MEMBER_NO=simulation-maintainer
BIG_APPLE_SIMULATION_BOOTSTRAP_MAINTAINER_DISPLAY_NAME=Simulation maintainer

# Example for adding another configured simulation world:
# BIG_APPLE_WORLD_DATABASE_ALIASES=realworld,simulation0001,simulation0002
# BIG_APPLE_SIMULATION0002_DB_NAME=dev_big_sim0002

# start.bat expects an existing mysql97 container and nginx container on dev-net.
